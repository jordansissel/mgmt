import "res/password"

# This demonstrates reading a generated password back into the language with the
# res/password value function. The password resource generates a random password
# and publishes it over the internal Bridge API. The password.value() function
# reads that live value by the resource name. Until the resource has generated
# one, the function errors, so we pair it with the except operator to fall back
# to a default value in the meantime.
#
# Run mgmt:
#
#	mgmt run --tmp-prefix lang examples/lang/password1.mcl
#
# In another terminal, watch the managed output file flip from the default to
# the generated password:
#
#	watch -n 0.5 cat /tmp/mgmt/password

password "pass1" {
	length => 32,
	# ephemeral by default, but this is fine, we read it over the bridge
	#write => false,
	newline => true, # useful since we write to a file
}

$secret = password.value("pass1") <|> "hunter2\n"

file "/tmp/mgmt/password" {
	state => $const.res.file.state.exists,
	content => $secret,
}

file "/tmp/mgmt/" {
	state => $const.res.file.state.exists,
}
