password "pass0" {
	length => 32,
	write => true, # default is ephemeral
	newline => true, # useful since we write to a file
}

file "/tmp/mgmt/password" {
	state => $const.res.file.state.exists,
}

Password["pass0"].password -> File["/tmp/mgmt/password"].content

file "/tmp/mgmt/" {
	state => $const.res.file.state.exists,
}
